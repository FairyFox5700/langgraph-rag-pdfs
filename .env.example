# Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Deployment names (as configured in Azure AI Foundry / Azure OpenAI Studio)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Paths (relative to project root, defaults shown)
PDF_DIR=data/pdfs
CHROMA_DIR=chroma_db

# Azure AI Document Intelligence (layout model: text + tables + figure boxes)
# Create a "Document Intelligence" resource in the Azure portal or AI Foundry.
AZURE_DOC_INTEL_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_API_KEY=<your-doc-intel-key>

# Set to false to skip vision captioning of figures/images (faster, cheaper,
# text+tables only). Requires AZURE_OPENAI_CHAT_DEPLOYMENT to be vision-capable
# (e.g. gpt-4o) when true.
CAPTION_IMAGES=true
